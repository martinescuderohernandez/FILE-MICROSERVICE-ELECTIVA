# ============================================================
# FILE MICROSERVICE - variables de entorno
# Copia este archivo como .env y completa los valores reales.
# ============================================================

APP_NAME=file-microservice
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# ------------------------------------------------------------
# JWT: debe ser EXACTAMENTE el mismo JWT_SECRET del user-microservice.
# El valor esta codificado en Base64 (asi lo decodifica Spring Boot con
# Base64.getDecoder().decode(secret)). Debe decodificar a >= 32 bytes.
# ------------------------------------------------------------
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_ALGORITHM=HS256

# ------------------------------------------------------------
# Backblaze B2 (API compatible con S3)
# La Application Key debe estar restringida al bucket y NO necesita
# permiso de listado de buckets (listBuckets).
# ------------------------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=certificados-lab-dev-2026
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# ------------------------------------------------------------
# Limites y URLs de descarga
# ------------------------------------------------------------
MAX_PHOTO_BYTES=5242880
MAX_DOCUMENT_BYTES=20971520
PRESIGNED_URL_TTL_SECONDS=300
DEFAULT_LIST_LIMIT=20
MAX_LIST_LIMIT=100

# Origenes separados por coma, o * para desarrollo.
CORS_ORIGINS=*

# ------------------------------------------------------------
# Verificacion opcional de existencia del usuario.
# Deshabilitada por defecto: el file-microservice confia en el JWT
# emitido por el user-microservice. Si se habilita, la cuenta debe
# tener rol ADMIN porque GET /api/users/{id} exige ADMIN/REVIEWER.
# ------------------------------------------------------------
USER_SERVICE_ENABLED=false
USER_SERVICE_BASE_URL=http://localhost:8080
USER_SERVICE_ADMIN_EMAIL=
USER_SERVICE_ADMIN_PASSWORD=
USER_SERVICE_TIMEOUT_SECONDS=5
